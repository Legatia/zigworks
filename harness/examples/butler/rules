# The butler's lines in rules. /setup home adds the first part, /setup car
# the second, and /setup routines the lines of the routines you turn on.

# the home: reading it needs no question; what you ask for switches what
# home.ini allows (locks, the garage and valves stay asked every time:
# home_guarded is a money tool in mcp.ini)
allow mcp home/home_state *
allow mcp home/home_wait *
[owner]
allow mcp home/home_set *
[all]

# the car: reading it needs no question; charging and the charge limit
# when you ask. car.ini (as /setup car writes it) allows car_command only
# charge_start, charge_stop and charge_limit (60-90 %): carcloud refuses the
# rest, locking and unlocking among them. That list is what bounds the
# allow line below; never pair it with an ask or deny for part of the same
# tool (the gate matches the call's JSON as written, so a space or another
# key order would slip past the ask): add lock to car.ini and it is unasked.
allow mcp car/car_status *
[owner]
allow mcp car/car_command *
[all]

# goodnight: its run switches the lights and the heating
[workflow:goodnight/night]
allow mcp home/home_set *
[all]

# arriving: the heating back up, this call alone (exact, its keys in
# order, so it matches however the gate reads JSON; any other call is asked)
[workflow:arriving/heat]
allow mcp home/home_set {"action":"temperature","device":"<thermostat>","value":"<home temp>"}
[all]

# away: what harness does by itself while you're away (as harness:away):
# the lights go on and off in the evening (/away lights changes which),
# and the heating goes back up before you come home; these calls alone
[harness:away]
<away calls>
[all]

# the morning summary: the calendar is read (calmcp's cal_agenda), never
# changed (its changes are asked every time, and never offered to the step)
[workflow:morning-home/read]
allow mcp calendar/cal_agenda *
[all]

# the calendar: reading it needs no question; its changes (cal_create,
# cal_move, cal_cancel, cal_reply) are money tools in mcp.ini, asked every
# time, and calmcp's file says in which calendars they may be made
allow mcp calendar/cal_agenda *
allow mcp calendar/cal_free *
allow mcp calendar/cal_event *
